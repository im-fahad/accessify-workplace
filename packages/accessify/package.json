{
  "name": "@glitchlab/accessify",
  "version": "0.0.1",
  "license": "MIT",
  "main": "./dist/core.cjs.js",
  "module": "./dist/core.esm.js",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": {
      "import": "./dist/core.esm.js",
      "require": "./dist/core.cjs.js",
      "types": "./dist/core.d.ts"
    },
    "./react": {
      "import": "./dist/react.esm.js",
      "require": "./dist/react.cjs.js",
      "types": "./dist/react.d.ts"
    },
    "./vue": {
      "import": "./dist/vue.esm.js",
      "require": "./dist/vue.cjs.js",
      "types": "./dist/vue.d.ts"
    },
    "./svelte": {
      "import": "./dist/svelte.esm.js",
      "require": "./dist/svelte.cjs.js",
      "types": "./dist/svelte.d.ts"
    }
  },
  "files": ["dist"],
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17",
    "vue": ">=3",
    "svelte": ">=4"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "vue": { "optional": true },
    "svelte": { "optional": true }
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "vue": "^3.5.0",
    "svelte": "^4.2.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  }
}
