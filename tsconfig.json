{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@glitchlab/accessify": ["./packages/accessify/src"],
      "@glitchlab/accessify/*": ["./packages/accessify/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
